# Discord bot — fill from the Discord Developer Portal runbook
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CONVERSATIONS_CHANNEL_ID=
DISCORD_SCHEDULER_CHANNEL_ID=
# Comma-separated Discord user IDs allowed to interact with the bot (TLC-1)
DISCORD_ALLOWED_USER_IDS=

# claude CLI — path inside the container. Auth state lives at $HOME/.claude;
# Dockerfile sets HOME=/data so auth persists on the mounted volume.
CLAUDE_BINARY_PATH=claude
CLAUDE_AUTH_DIR=/data/claude-auth

# Where conversations.db, scheduler state, etc. live (mounted volume)
DATA_DIR=/data

# Default model for claude_cli provider — use a CLI tier tag ("sonnet",
# "opus", "fable") to auto-track latest, or pin a full ID like
# "claude-sonnet-4-6". Dated aliases ("sonnet-4-6") 404 under setup-token auth.
CLAUDE_DEFAULT_MODEL=opus

# Cheap tier — internal work (auto-compaction, retrospective extraction, the
# eval tone judge). Defaults to `claude_cli_cheap:sonnet`: the subscription
# CLI with tools blanket-disabled, so internal calls cost no metered dollars.
# Use an `anthropic_api:` route to put this work on metered API capacity
# instead (independent of the subscription's rate-limit pool). Empty disables.
# A `/model action:cheap` override is persisted in the DB and wins over this.
# CHEAP_TIER_ROUTE=claude_cli_cheap:sonnet

# v2: anthropic_api provider (optional). When set, anthropic_api is
# registered and can be selected via /model or used as rate-limit failover.
# EMBER_ANTHROPIC_API_KEY=sk-ant-...

# v3: MCP outbound (memory + documents). Defaults assume local containers.
# MEMORY_MCP_URL=http://localhost:9927/mcp
# DOCUMENTS_MCP_URL=http://localhost:9929/mcp

# v3: vault skill — memory-MCP secrets broker. The token here must
# correspond to an entry in the memory container's BROKER_TOKENS env.
VAULT_BROKER_URL=http://localhost:9927
# VAULT_BROKER_TOKEN=

# --- Schwab brokerage (optional) -------------------------------------------
# Tools register only when both SCHWAB_APP_KEY and SCHWAB_APP_SECRET are set.
# SCHWAB_APP_KEY=
# SCHWAB_APP_SECRET=
# SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
# Comma-separated last4=name pairs.
# SCHWAB_ACCOUNT_NAMES=1234=Individual Brokerage,5678=Roth Contributory IRA
# Comma-separated friendly names allowed for write. Empty = read-only.
# SCHWAB_ALLOWED_ACCOUNTS=Individual Brokerage,Roth Contributory IRA
# Notional caps in USD.
# SCHWAB_MAX_ORDER_NOTIONAL_USD=20000
# SCHWAB_MAX_BATCH_NOTIONAL_USD=75000
# SCHWAB_MAX_DAILY_NOTIONAL_USD=100000

# Logging
LOG_LEVEL=INFO

# Tiller (optional). tiller_query registers when TILLER_DB_PATH is set and
# the file exists — the tiller-sync service's twice-daily SQLite snapshot,
# mounted read-only at /data/tiller in compose.yml.
TILLER_DB_PATH=/data/tiller/tiller.db

# --- paperless / documents indexer (doc #59, optional) ----------------------
# The docs_search / docs_fetch / docs_file / docs_sync tools and records.db
# open only when PAPERLESS_API_TOKEN is set (mint it for a dedicated `ember`
# user in the paperless UI). paperless runs in its own compose project on the
# shared home-proxy network, so the default base URL needs no compose change.
# PAPERLESS_API_TOKEN=
# PAPERLESS_BASE_URL=http://paperless:8000
# Only true once the Tika + Gotenberg sidecars run next to paperless — widens
# the docs_file allowlist to office formats (docx/xlsx/…).
# PAPERLESS_TIKA_ENABLED=false
# Where result links point (paperless web UI as reached from the tailnet/LAN).
# DOCS_PUBLIC_URL=http://localhost:9926
# paperless tag that keeps a document out of the index (driver's license,
# passport, anything with an SSN). Matched case-insensitively.
# DOCS_EXCLUDE_TAG=ember-exclude

# --- Unlock windows (doc #60, TLC-31) ----------------------------------
# Tools listed in LOCKED_TOOLS are gated per conversation: one valid
# authenticator code (`y <code>` at the 🔒 prompt, or a bare `unlock <code>`)
# opens the thread for UNLOCK_TTL_SECONDS; `/lock` ends it early; a restart
# re-locks everything. Reuses CONFIRM_TOTP_SECRET and fails closed without it.
# Default: the cleartext vault read only. Doc #60's full personal-data set:
# LOCKED_TOOLS=vault_get,vault_list,gmail_list,gmail_search,gmail_read,docs_search,docs_fetch,history_search,history_fetch,tiller_query
#UNLOCK_TTL_SECONDS=14400
#LOCKED_TOOLS=vault_get

# --- compose host wiring (optional) -----------------------------------------
# Host directory holding tiller-sync's snapshot (mounted read-only).
# TILLER_HOST_DIR=/srv/tiller-sync/data
# LAN DNS resolver for the container (e.g. a pihole on the host).
# LAN_DNS=192.168.1.2
# Address the Siri ingress port binds to — your Tailscale IP for tailnet-only.
# SIRI_BIND_IP=127.0.0.1

# --- daily_digest skill -----------------------------------------------------
# DIGEST_RECIPIENT=me@example.org
# DIGEST_LABELS=INBOX,News
# DIGEST_WEATHER_LAT=44.9778
# DIGEST_WEATHER_LON=-93.2650
# DIGEST_WEATHER_PLACE=Minneapolis
# MEALIE_PUBLIC_URL=http://mealie.local
